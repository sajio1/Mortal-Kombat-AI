   "source": [
    "import retro\n",
    "\n",
    "env = retro.make(game='MortalKombatII-Genesis')\n",
    "obs = env.reset()\n",
    "\n",
    "while True:\n",
    "    env.render()\n",
    "    action = env.action_space.sample()  \n",
    "    obs, reward, done, info = env.step(action)\n",
    "    \n",
    "    if done:\n",
    "        obs = env.reset()\n",
    "\n",
    "env.close()\n"
   ]
  },
